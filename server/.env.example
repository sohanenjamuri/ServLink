# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/serviceconnect?retryWrites=true&w=majority

# For local development (if not using Atlas)
# MONGODB_URI=mongodb://localhost:27017/serviceconnect

# JWT Secret (for authentication - to be implemented later)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d